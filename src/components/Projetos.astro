---
const projects = [
  {
    title: 'Templo de Salomão',
    category: 'Institucional',
    description: 'Templo nos moldes do Templo de Salomão em Gramado/RS. Projeto com circuito de visitação turística, esplanada, Jardim Bíblico, Jardim das Oliveiras, área de reunião para 400 pessoas, auditório, Arca Center e espaço multiuso.',
    tags: ['Institucional', 'Alto Padrão', 'Gramado/RS'],
    images: [
      { src: '/images/Templo1.jpg', alt: 'Templo de Salomão — Perspectiva' },
      { src: '/images/Templo2.jpeg', alt: 'Templo de Salomão — Detalhe' },
    ],
    year: 'Em Andamento',
    company: 'Igreja Universal do Reino de Deus',
    link: 'https://www.universal.org/noticias/post/gramado-no-rio-grande-do-sul-recebe-projeto-nos-moldes-do-templo-de-salomao/',
  },
  {
    title: 'Vêneto by Hasam',
    category: 'Residencial',
    description: 'Condomínio de 10 torres entre árvores e lago em Gramado/RS. 106 unidades de 65m² a 133m² com lazer completo: piscinas, spa, cinema, academia, salão de festas e muito mais.',
    tags: ['Alto Padrão', '10 Torres', 'Gramado/RS'],
    images: [
      { src: '/images/Vêneto1.jpg', alt: 'Vêneto — Vista geral' },
      { src: '/images/Vêneto2.jpg', alt: 'Vêneto — Área de lazer' },
      { src: '/images/Vêneto3.jpg', alt: 'Vêneto — Detalhe' },
    ],
    year: 'Entregue 03/2024',
    company: 'Hasam Incorporações',
    link: 'https://incorporadora.hasam.com.br/empreedimentos/veneto/',
  },
  {
    title: 'Athos by Construarte',
    category: 'Residencial',
    description: 'Empreendimento alto padrão em Igrejinha/RS com 22 pavimentos. Apartamentos de 86m² a 390m², clube de lazer completo com piscina aquecida, academia, lounge e terraço fitness.',
    tags: ['Alto Padrão', '22 Pavimentos', 'Igrejinha/RS'],
    images: [
      { src: '/images/Athos1.jpg', alt: 'Athos — Vista externa' },
      { src: '/images/Athos2.jpg', alt: 'Athos — Detalhe' },
    ],
    year: 'Entrega 05/2026',
    company: 'Irmãos Kunst / Construarte',
    link: 'https://www.irmaoskunst.com.br/empreendimento/12/athos',
  },
  {
    title: 'Instalações Prediais — Itec Engenharia',
    category: 'Corporativo',
    description: 'Projetos e execução de instalações prediais para grandes corporações. Clientes incluem Taurus Armas, Krupp Indústrias e Termas Resort Gramado, entre outros.',
    tags: ['Instalações Prediais', 'Industrial', '2020–2024'],
    images: [
      { src: '/images/projeto-itec.svg', alt: 'Itec — Desenho técnico' },
    ],
    year: '2020 – 2024',
    company: 'Itec Engenharia',
    clients: ['Taurus Armas', 'Krupp Indústrias', 'Termas Resort Gramado'],
  },
];

const categories = ['Todos', 'Residencial', 'Institucional', 'Corporativo'];
---

<section id="projetos" class="relative">
  <div class="absolute bottom-0 left-0 w-1/2 h-1/2 bg-gradient-to-tr from-primary-100/30 to-transparent"></div>

  <div class="section-padding">
    <div class="max-w-6xl mx-auto">
      <!-- Section header -->
      <div class="mb-12">
        <span class="text-sm font-semibold tracking-widest uppercase text-accent-500 mb-4 block">Portfólio</span>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-sand-900">
          Projetos <span class="gradient-text">em destaque</span>
        </h2>
      </div>

      <!-- Filter tabs -->
      <div class="flex flex-wrap gap-3 mb-12" id="filter-tabs">
        {categories.map((cat, i) => (
          <button
            class={`px-5 py-2 rounded-full text-sm font-medium transition-all duration-300 ${
              i === 0
                ? 'bg-accent-400 text-white shadow-lg shadow-accent-400/25'
                : 'glass text-sand-600 hover:text-sand-900 glass-hover'
            }`}
            data-filter={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Projects grid -->
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
        {projects.map((project, pIdx) => (
          <div
            class="group relative rounded-2xl overflow-hidden glass glass-hover project-card"
            data-category={project.category}
          >
            <!-- Image / Slideshow -->
            <div class="aspect-[4/3] relative overflow-hidden card-slideshow" data-project={pIdx}>
              {project.images.length > 1 ? (
                project.images.map((img, i) => (
                  <div
                    class:list={[
                      'card-slide absolute inset-0 transition-opacity duration-700 ease-in-out',
                      i === 0 ? 'opacity-100' : 'opacity-0',
                    ]}
                    data-card-idx={pIdx}
                    data-card-slide={i}
                  >
                    <img
                      src={img.src}
                      alt={img.alt}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                      loading="lazy"
                    />
                  </div>
                ))
              ) : (
                <img
                  src={project.images[0].src}
                  alt={project.images[0].alt}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  loading="lazy"
                />
              )}

              <div class="absolute inset-0 bg-gradient-to-t from-sand-900/60 via-sand-900/10 to-transparent z-10"></div>

              <!-- Dots -->
              {project.images.length > 1 && (
                <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-20 flex gap-1.5">
                  {project.images.map((_, i) => (
                    <span
                      class:list={[
                        'card-dot w-1.5 h-1.5 rounded-full transition-all duration-500',
                        i === 0 ? 'bg-white w-4' : 'bg-white/40',
                      ]}
                      data-card-dot-p={pIdx}
                      data-card-dot-i={i}
                    />
                  ))}
                </div>
              )}

              <!-- Year badge -->
              <div class="absolute top-4 right-4 z-20 glass rounded-full px-3 py-1">
                <span class="text-xs font-semibold text-sand-800">{project.year}</span>
              </div>

              <!-- Category -->
              <div class="absolute bottom-4 left-4 z-20">
                <span class="text-xs font-bold tracking-wider uppercase text-accent-400">{project.category}</span>
              </div>
            </div>

            <!-- Content -->
            <div class="p-6">
              <p class="text-xs font-semibold text-primary-600 mb-1">{project.company}</p>
              <h3 class="font-display font-semibold text-sand-900 text-lg mb-2 group-hover:text-accent-500 transition-colors">
                {project.title}
              </h3>
              <p class="text-sm text-sand-600 leading-relaxed mb-4">
                {project.description}
              </p>
              {'clients' in project && (
                <div class="mb-4">
                  <span class="text-xs text-sand-500 block mb-2">Clientes:</span>
                  <div class="flex flex-wrap gap-2">
                    {project.clients.map((client: string) => (
                      <span class="text-xs px-3 py-1 rounded-full bg-primary-50 text-primary-700 font-medium border border-primary-200">
                        {client}
                      </span>
                    ))}
                  </div>
                </div>
              )}
              <div class="flex flex-wrap gap-2">
                {project.tags.map((tag) => (
                  <span class="text-xs px-3 py-1 rounded-full bg-accent-50 text-accent-600 font-medium border border-accent-200">
                    {tag}
                  </span>
                ))}
              </div>
              {'link' in project && (
                <a href={project.link} target="_blank" rel="noopener noreferrer" class="mt-4 inline-flex items-center gap-2 text-sm text-accent-500 hover:text-accent-600 transition-colors group/link">
                  Ver empreendimento
                  <svg class="w-4 h-4 transition-transform group-hover/link:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                  </svg>
                </a>
              )}
            </div>

            <!-- Hover overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-accent-400/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none z-5"></div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const INTERVAL = 4000;

    const cardSlides = document.querySelectorAll('.card-slide') as NodeListOf<HTMLElement>;
    const cardDots = document.querySelectorAll('.card-dot') as NodeListOf<HTMLElement>;
    const cardStates: Record<number, { current: number; timer: ReturnType<typeof setInterval> | null }> = {};

    cardSlides.forEach((slide) => {
      const pIdx = parseInt(slide.getAttribute('data-card-idx') || '0');
      if (!cardStates[pIdx]) cardStates[pIdx] = { current: 0, timer: null };
    });

    function cardGoTo(pIdx: number, slideIdx: number) {
      const state = cardStates[pIdx];
      if (!state) return;

      const slides = document.querySelectorAll(`.card-slide[data-card-idx="${pIdx}"]`) as NodeListOf<HTMLElement>;
      const dots = document.querySelectorAll(`.card-dot-p-${pIdx}`) as NodeListOf<HTMLElement>;

      slides[state.current]?.classList.remove('opacity-100');
      slides[state.current]?.classList.add('opacity-0');
      dots[state.current]?.classList.remove('bg-white', 'w-4');
      dots[state.current]?.classList.add('bg-white/40');

      state.current = slideIdx;

      slides[state.current]?.classList.remove('opacity-0');
      slides[state.current]?.classList.add('opacity-100');
      dots[state.current]?.classList.remove('bg-white/40');
      dots[state.current]?.classList.add('bg-white', 'w-4');
    }

    function cardNext(pIdx: number) {
      const slides = document.querySelectorAll(`.card-slide[data-card-idx="${pIdx}"]`);
      const total = slides.length;
      const state = cardStates[pIdx];
      if (!state || total <= 1) return;
      cardGoTo(pIdx, (state.current + 1) % total);
    }

    function cardStartAuto(pIdx: number) {
      const state = cardStates[pIdx];
      if (!state) return;
      const slides = document.querySelectorAll(`.card-slide[data-card-idx="${pIdx}"]`);
      if (slides.length <= 1) return;
      if (state.timer) clearInterval(state.timer);
      state.timer = setInterval(() => cardNext(pIdx), INTERVAL);
    }

    Object.keys(cardStates).forEach((pIdx) => {
      cardStartAuto(parseInt(pIdx));
    });

    document.querySelectorAll('.project-card').forEach((card) => {
      card.addEventListener('mouseenter', () => {
        const pIdx = parseInt(card.getAttribute('data-project') || card.querySelector('.card-slideshow')?.getAttribute('data-project') || '0');
        const state = cardStates[pIdx];
        if (state?.timer) clearInterval(state.timer);
      });
      card.addEventListener('mouseleave', () => {
        const pIdx = parseInt(card.querySelector('.card-slideshow')?.getAttribute('data-project') || '0');
        cardStartAuto(pIdx);
      });
    });

    const filterTabs = document.querySelectorAll('#filter-tabs button');
    const projectCards = document.querySelectorAll('.project-card');

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const filter = tab.getAttribute('data-filter');

        filterTabs.forEach((t) => {
          t.classList.remove('bg-accent-400', 'text-white', 'shadow-lg', 'shadow-accent-400/25');
          t.classList.add('glass', 'text-sand-600');
        });
        tab.classList.add('bg-accent-400', 'text-white', 'shadow-lg', 'shadow-accent-400/25');
        tab.classList.remove('glass', 'text-sand-600');

        projectCards.forEach((card) => {
          const category = card.getAttribute('data-category');
          if (filter === 'Todos' || category === filter) {
            (card as HTMLElement).style.display = '';
            (card as HTMLElement).style.opacity = '0';
            (card as HTMLElement).style.transform = 'scale(0.95)';
            setTimeout(() => {
              (card as HTMLElement).style.opacity = '1';
              (card as HTMLElement).style.transform = 'scale(1)';
            }, 50);
          } else {
            (card as HTMLElement).style.opacity = '0';
            (card as HTMLElement).style.transform = 'scale(0.95)';
            setTimeout(() => {
              (card as HTMLElement).style.display = 'none';
            }, 300);
          }
        });
      });
    });
  });
</script>

<style>
  .project-card {
    transition: opacity 0.3s ease, transform 0.3s ease;
  }
</style>
