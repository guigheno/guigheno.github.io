---
const skills = [
  { name: 'Gestão de Equipe', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
  { name: 'Instalações Prediais', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { name: 'Gestão de Materiais', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { name: 'Controle de Qualidade', icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z' },
  { name: 'Cronograma de Obras', icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z' },
  { name: 'Leitura de Projetos', icon: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z' },
  { name: 'Orçamento e Medição', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
  { name: 'Planejamento de Obras', icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01' },
  { name: 'Segurança do Trabalho', icon: 'M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4.5c-.77-.833-2.694-.833-3.464 0L3.34 16.5c-.77.833.192 2.5 1.732 2.5z' },
];

const experiences = [
  {
    period: '2025 - Atualmente',
    role: 'Engenheira Civil',
    company: 'Irmãos Kunst / Construarte',
    description: 'Responsável técnica pelo empreendimento Athos, edifício de alto padrão com 22 pavimentos em Igrejinha/RS.',
  },
  {
    period: '2024 - 2025',
    role: 'Supervisora de Obra',
    company: 'Hasam Incorporações',
    description: 'Supervisão técnica e controle de qualidade do empreendimento Vêneto, condomínio de alto padrão em Gramado/RS com 10 torres e lazer completo.',
  },
  {
    period: '2020 - 2024',
    role: 'Assistente de Engenharia',
    company: 'Itec Engenharia',
    description: 'Assistência técnica em projetos e execução de instalações prediais para grandes corporações: Taurus Armas, Krupp Indústrias, Termas Resort Gramado, entre outros.',
  },
];
---

<section id="sobre" class="relative">
  <div class="absolute top-0 right-0 w-1/3 h-full bg-gradient-to-l from-accent-100/50 to-transparent"></div>

  <div class="section-padding">
    <div class="max-w-6xl mx-auto">
      <!-- Section header -->
      <div class="mb-16">
        <span class="text-sm font-semibold tracking-widest uppercase text-accent-500 mb-4 block">Quem sou</span>
        <h2 class="font-display text-4xl md:text-5xl font-bold text-sand-900">
          Construindo <span class="gradient-text">futuro</span>
        </h2>
      </div>

      <div class="grid lg:grid-cols-2 gap-16 items-start">
        <!-- About text -->
        <div>
          <div class="space-y-6 text-sand-700 text-lg leading-relaxed">
            <p>
              Sou engenheira civil apaixonada por transformar projetos em realidade.
              Atuo no mercado gaúcho com experiência em instalações prediais, projetos
              residenciais de alto padrão e gestão técnica de obras.
            </p>
            <p>
              De 2020 a 2024, atuei na <strong class="text-sand-900">Itec Engenharia</strong>
              executando instalações prediais para grandes corporações como
              <strong class="text-sand-900">Taurus Armas</strong>,
              <strong class="text-sand-900">Krupp Indústrias</strong> e
              <strong class="text-sand-900">Termas Resort Gramado</strong>.
            </p>
            <p>
              Em 2024, supervisei a entrega do
              <strong class="text-sand-900">Vêneto</strong> em Gramado — condomínio de 210 unidades
              com a maior infraestrutura condominial da serra gaúcha.
              Atualmente, sou engenheira civil na
              <strong class="text-sand-900">Construarte</strong>, responsável pelo
              <strong class="text-sand-900">Athos</strong> em Igrejinha, empreendimento de alto padrão
              em construção.
            </p>
          </div>

          <!-- Skills -->
          <div class="mt-12">
            <h3 class="font-display text-lg font-semibold text-sand-900 mb-6">Competências</h3>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
              {skills.map((skill) => (
                <div class="glass rounded-xl px-4 py-3 flex items-center gap-3 glass-hover group">
                  <svg class="w-5 h-5 text-accent-500 shrink-0 group-hover:text-primary-500 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={skill.icon} />
                  </svg>
                  <span class="text-sm font-medium text-sand-700">{skill.name}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Experience -->
        <div>
          <h3 class="font-display text-lg font-semibold text-sand-900 mb-8">Experiência Profissional</h3>
          <div class="relative">
            <div class="absolute left-4 top-2 bottom-2 w-px bg-gradient-to-b from-accent-400 via-accent-400/50 to-transparent"></div>

            <div class="space-y-10">
              {experiences.map((exp, i) => (
                <div class="relative pl-12 group">
                  <div class="absolute left-2.5 top-1.5 w-3 h-3 rounded-full border-2 border-accent-400 bg-sand-50 group-hover:bg-accent-400 transition-colors"></div>

                  <div class="glass rounded-2xl p-6 glass-hover">
                    <span class="text-xs font-semibold tracking-wider uppercase text-accent-500">{exp.period}</span>
                    <h4 class="font-display font-semibold text-sand-900 text-lg mt-2">{exp.role}</h4>
                    <p class="text-sm text-primary-600 font-medium mt-1">{exp.company}</p>
                    <p class="text-sm text-sand-600 mt-3 leading-relaxed">{exp.description}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
