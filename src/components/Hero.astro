---
---

<section id="inicio" class="relative min-h-screen flex items-center overflow-hidden">
  <!-- Background image -->
  <div class="absolute inset-0">
    <img
      src="/images/fundoinicial.jpg"
      alt=""
      class="w-full h-full object-cover"
      aria-hidden="true"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-sand-50/95 via-sand-50/70 to-sand-50/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-sand-50 via-transparent to-sand-50/50"></div>
  </div>

  <div class="section-padding relative z-10 w-full">
    <div class="max-w-5xl mx-auto">
      <!-- Badge -->
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass mb-8 animate-fade-in-up">
        <span class="w-2 h-2 rounded-full bg-green-500 animate-pulse"></span>
        <span class="text-sm text-sand-600">Disponível para projetos</span>
      </div>

      <!-- Title -->
      <h1 class="font-display text-5xl md:text-7xl lg:text-8xl font-bold leading-[0.95] mb-6 animate-fade-in-up" style="animation-delay: 0.1s;">
        <span class="text-sand-900">Engenheira</span><br />
        <span class="gradient-text">Civil</span>
      </h1>

      <!-- Name -->
      <p class="text-xl md:text-2xl font-display font-medium text-sand-600 mb-6 animate-fade-in-up" style="animation-delay: 0.2s;">
        Daísy de Carvalho
      </p>

      <!-- Description -->
      <p class="text-lg md:text-xl text-sand-600 max-w-2xl leading-relaxed mb-10 animate-fade-in-up" style="animation-delay: 0.3s;">
        Transformando visões em estruturas sólidas. Especializada em projetos
        residenciais e comerciais com foco em inovação, sustentabilidade e
        excelência técnica.
      </p>

      <!-- CTAs -->
      <div class="flex flex-wrap gap-4 animate-fade-in-up" style="animation-delay: 0.4s;">
        <a
          href="#projetos"
          class="group inline-flex items-center gap-3 px-8 py-4 rounded-full bg-gradient-to-r from-accent-400 to-accent-500 font-semibold text-white shadow-xl shadow-accent-400/25 hover:shadow-accent-400/40 transition-all duration-300 hover:-translate-y-0.5"
        >
          Ver Projetos
          <svg class="w-5 h-5 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        <a
          href="#sobre"
          class="inline-flex items-center gap-3 px-8 py-4 rounded-full glass glass-hover font-semibold text-sand-700"
        >
          Sobre Mim
        </a>
      </div>

      <!-- Stats -->
      <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-8 animate-fade-in-up" style="animation-delay: 0.5s;">
        <div class="text-center md:text-left">
          <div class="text-3xl md:text-4xl font-display font-bold gradient-text">5+</div>
          <div class="text-sm text-sand-500 mt-1">Anos de Experiência</div>
        </div>
        <div class="text-center md:text-left">
          <div class="text-3xl md:text-4xl font-display font-bold gradient-text">3</div>
          <div class="text-sm text-sand-500 mt-1">Empreendimentos Ativos</div>
        </div>
        <div class="text-center md:text-left">
          <div class="text-3xl md:text-4xl font-display font-bold gradient-text">100%</div>
          <div class="text-sm text-sand-500 mt-1">Comprometimento</div>
        </div>
        <div class="text-center md:text-left">
          <div class="text-3xl md:text-4xl font-display font-bold gradient-text">RS</div>
          <div class="text-sm text-sand-500 mt-1">Sede — Gaúcha</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 animate-fade-in-up" style="animation-delay: 0.7s;">
    <span class="text-xs text-sand-400 tracking-widest uppercase">Scroll</span>
    <div class="w-5 h-8 rounded-full border border-sand-300 flex items-start justify-center p-1">
      <div class="w-1.5 h-1.5 rounded-full bg-accent-400 animate-bounce"></div>
    </div>
  </div>
</section>
